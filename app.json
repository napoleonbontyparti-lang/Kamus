{
  "expo": {
    "name": "KataCil",
    "slug": "kamus-korigodsky",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.veronika.kamus"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF3E0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ru.veronika.kamus",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "kamus",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#FFF8EE",
          "dark": {
            "backgroundColor": "#1D1813"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KataCil использует фото, чтобы распознать текст и найти слова в словаре, а также для аватара.",
          "cameraPermission": "KataCil использует камеру, чтобы сфотографировать текст и найти слова в словаре, а также для аватара.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/Nunito_900Black.ttf",
            "./assets/fonts/Nunito_700Bold.ttf"
          ],
          "widgets": [
            {
              "name": "Streak",
              "label": "KataCil — дни подряд",
              "description": "Канчиль, синий огонёк и сколько дней подряд вы занимаетесь",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget-preview.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "supabase": {
        "url": "https://zywovljweygnnvwracyv.supabase.co",
        "anonKey": "sb_publishable_kUiT4NnHI3-Mlagq2TlLwQ_xBaigQJY"
      }
    }
  }
}